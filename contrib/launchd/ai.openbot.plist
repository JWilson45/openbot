<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent (user session). Do not install as a LaunchDaemon. Chromium must not run as root. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.openbot</string>
	<key>ProgramArguments</key>
	<array>
__PROGRAM_ARGUMENTS__
	</array>
	<key>WorkingDirectory</key>
	<string>__WORKDIR__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>OPENBOT_HOME</key>
		<string>__HOME__</string>
		<key>HOME</key>
		<string>__USER_HOME__</string>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
